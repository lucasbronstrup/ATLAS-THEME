{% if section.settings.layout == 'carousel' %}
  {{ 'product-carousel.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-carousel.js' | asset_url }}" defer></script>
{% endif %}
{%- liquid
  assign source_blog = section.settings.blog
  assign article_count = source_blog.articles.size | default: 0
  assign blog_url = section.settings.link | default: source_blog.url
  assign blog_link_label = section.settings.link_label
  if blog_link_label == blank
    assign blog_link_label = 'secondary.blog.view_blog' | t
  endif
  assign heading_fallback = source_blog.title
  if heading_fallback == blank
    assign heading_fallback = 'secondary.blog.title' | t
  endif
-%}
<div class="section featured-blog{% if section.settings.layout == 'carousel' %} atlas-product-row{% endif %}" {% if section.settings.layout == 'carousel' %}data-product-carousel data-carousel-status-format="{{ 'secondary.blog.carousel_position' | t: current: '__current__', total: '__total__' | escape }}"{% endif %} style="--section-bg: {{ section.settings.background }}; --background: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px; --blog-columns: {{ section.settings.columns }}; --blog-mobile-columns: {{ section.settings.mobile_columns }}; --carousel-columns: {{ section.settings.columns }}; --carousel-mobile-columns: {{ section.settings.carousel_mobile_columns }}; --article-image-ratio: {{ section.settings.image_ratio }}" {% if article_count == 0 and request.design_mode == false %}hidden{% endif %}>
  <div class="container">
    <div class="section-heading">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        <h2 id="FeaturedBlogHeading-{{ section.id }}" {% if section.settings.heading == blank %}class="visually-hidden"{% endif %}>{{ section.settings.heading | default: heading_fallback | escape }}</h2>
        {% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}
      </div>
      <div class="featured-blog__actions">
        {% if section.settings.show_view_all and blog_url != blank %}<a class="text-link" href="{{ blog_url }}">{{ blog_link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}
        {% if section.settings.layout == 'carousel' %}
          <div class="atlas-carousel-controls" data-carousel-controls hidden>
            <button class="icon-button" type="button" data-carousel-prev aria-label="{{ 'secondary.blog.carousel_previous' | t }}" aria-controls="FeaturedBlogTrack-{{ section.id }}" disabled>{% render 'icon', name: 'arrow' %}</button>
            <button class="icon-button" type="button" data-carousel-next aria-label="{{ 'secondary.blog.carousel_next' | t }}" aria-controls="FeaturedBlogTrack-{{ section.id }}">{% render 'icon', name: 'arrow' %}</button>
          </div>
        {% endif %}
      </div>
    </div>
    {% if article_count > 0 %}
      <div class="{% if section.settings.layout == 'carousel' %}atlas-carousel-track featured-blog__track{% else %}featured-blog__grid{% endif %}" {% if section.settings.layout == 'carousel' %}id="FeaturedBlogTrack-{{ section.id }}" data-carousel-track tabindex="0" role="region" aria-labelledby="FeaturedBlogHeading-{{ section.id }}"{% endif %}>
        {% for article in source_blog.articles limit: section.settings.limit %}
          {% if section.settings.layout == 'carousel' %}<div class="atlas-carousel-cell">{% endif %}
          {% render 'article-card', article: article, heading_level: 'h3', show_image: section.settings.show_image, show_title: section.settings.show_title, show_date: section.settings.show_date, show_author: section.settings.show_author, show_excerpt: section.settings.show_excerpt, show_read_more: section.settings.show_read_more, excerpt_length: section.settings.excerpt_length %}
          {% if section.settings.layout == 'carousel' %}</div>{% endif %}
        {% endfor %}
      </div>
      {% if section.settings.layout == 'carousel' %}<span class="visually-hidden" data-carousel-status aria-live="polite" aria-atomic="true"></span>{% endif %}
    {% elsif request.design_mode %}
      <p class="featured-blog__empty muted">{{ 'secondary.blog.editor_empty' | t }}</p>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name":"Blog em destaque",
  "tag":"section",
  "disabled_on":{"groups":["header","footer"]},
  "settings":[
    {"type":"text","id":"eyebrow","label":"Texto superior"},
    {"type":"text","id":"heading","label":"Título","default":"Conteúdos para inspirar."},
    {"type":"richtext","id":"text","label":"Descrição"},
    {"type":"blog","id":"blog","label":"Blog"},
    {"type":"range","id":"limit","label":"Quantidade de posts","min":1,"max":12,"step":1,"default":3},
    {"type":"select","id":"layout","label":"Exibição dos posts","options":[{"value":"grid","label":"Grade"},{"value":"carousel","label":"Carrossel"}],"default":"grid"},
    {"type":"range","id":"columns","label":"Posts visíveis no computador","min":2,"max":4,"step":1,"default":3},
    {"type":"select","id":"mobile_columns","label":"Colunas da grade no celular","options":[{"value":"1","label":"1"},{"value":"2","label":"2"}],"default":"1"},
    {"type":"select","id":"carousel_mobile_columns","label":"Posts visíveis no carrossel no celular","options":[{"value":"1","label":"1"},{"value":"1.5","label":"1,5"},{"value":"2","label":"2"}],"default":"1.5"},
    {"type":"header","content":"Cartões dos posts"},
    {"type":"checkbox","id":"show_image","label":"Mostrar imagem","default":true},
    {"type":"select","id":"image_ratio","label":"Proporção da imagem","options":[{"value":"1.5","label":"Paisagem"},{"value":"1","label":"Quadrado"},{"value":"0.8","label":"Retrato"}],"default":"1.5"},
    {"type":"checkbox","id":"show_title","label":"Mostrar título do post","default":true},
    {"type":"checkbox","id":"show_excerpt","label":"Mostrar resumo","default":true},
    {"type":"range","id":"excerpt_length","label":"Comprimento do resumo","min":80,"max":240,"step":20,"default":160},
    {"type":"checkbox","id":"show_date","label":"Mostrar data","default":true},
    {"type":"checkbox","id":"show_author","label":"Mostrar autor","default":false},
    {"type":"checkbox","id":"show_read_more","label":"Mostrar link para ler o post","default":true},
    {"type":"header","content":"Link para o blog"},
    {"type":"checkbox","id":"show_view_all","label":"Mostrar link para o blog","default":true},
    {"type":"text","id":"link_label","label":"Texto do link","default":"Ver todos os posts"},
    {"type":"url","id":"link","label":"Link personalizado (opcional)","info":"Vazio usa o endereço do blog selecionado."},
    {"type":"color","id":"background","label":"Fundo","default":"#ffffff"},
    {"type":"color","id":"text_color","label":"Texto","default":"#172229"},
    {"type":"range","id":"padding_top","label":"Espaço superior","min":0,"max":120,"step":4,"default":48,"unit":"px"},
    {"type":"range","id":"padding_bottom","label":"Espaço inferior","min":0,"max":120,"step":4,"default":48,"unit":"px"}
  ],
  "presets":[{"name":"Blog em destaque"}]
}
{% endschema %}
