{{ 'visual-sections.css' | asset_url | stylesheet_tag }}
<div class="section atlas-visual-section" style="{% if section.settings.spacing > 0 %}--visual-space:{{ section.settings.spacing }}px;{% endif %}{% if section.settings.mobile_spacing > 0 %}--visual-space-mobile:{{ section.settings.mobile_spacing }}px;{% endif %}{% if section.settings.background != blank %}--section-bg:{{ section.settings.background }};--background:{{ section.settings.background }};{% endif %}{% if section.settings.text_color != blank %}--section-ink:{{ section.settings.text_color }};--ink:{{ section.settings.text_color }};{% endif %}"><div class="container">{% if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.text != blank %}<div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div></div>{% endif %}<div class="atlas-offer-grid" style="--offer-columns:{{ section.settings.columns }};--offer-mobile-columns:{{ section.settings.mobile_columns }}">
{% for block in section.blocks %}{% assign offer_product = block.settings.product %}{% assign offer_image = block.settings.image | default: offer_product.featured_image %}{% assign destination = block.settings.link | default: offer_product.url %}<article class="atlas-offer-card atlas-visual-card" {{ block.shopify_attributes }}>
<div class="atlas-offer-card__media atlas-visual-media">{% if offer_image %}{{ offer_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '250,400,600,800,1000', sizes: '(min-width: 990px) 33vw, 50vw', alt: block.settings.image_alt }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'atlas-offer-card__placeholder' }}{% endif %}{% if block.settings.label != blank %}<span class="atlas-offer-card__label">{{ block.settings.label | escape }}</span>{% endif %}</div>
<div class="atlas-offer-card__copy">{% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}<h3>{{ block.settings.heading | default: offer_product.title | escape }}</h3>{% if block.settings.text != blank %}<p class="muted">{{ block.settings.text | escape }}</p>{% endif %}{% if offer_product != blank %}{% render 'price', product: offer_product %}{% elsif block.settings.price_text != blank %}<p class="atlas-offer-card__price">{{ block.settings.price_text | escape }}</p>{% endif %}{% if block.settings.coupon_code != blank %}<p class="atlas-offer-card__coupon"><span>{{ block.settings.coupon_label | escape }}</span><strong>{{ block.settings.coupon_code | escape }}</strong></p>{% endif %}{% if destination != blank and block.settings.button_label != blank %}<a class="button button--secondary" href="{{ destination }}">{{ block.settings.button_label | escape }}{% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
</article>{% endfor %}</div></div></div>
{% schema %}
{
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "name": "Cartões de ofertas",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Espaço no computador (0 usa o tema)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "label": "Espaço no celular (0 usa o tema)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0,
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo (vazio usa o tema)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto (vazio usa o tema)"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colunas no computador",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Colunas no celular",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Oferta",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produto (preço e link reais)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem personalizada"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Descrição acessível da imagem"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Texto de apoio"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título (vazio usa o produto)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descrição"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Etiqueta (opcional)"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Texto comercial (sem produto)"
        },
        {
          "type": "text",
          "id": "coupon_label",
          "label": "Legenda do cupom",
          "default": "Cupom"
        },
        {
          "type": "text",
          "id": "coupon_code",
          "label": "Código de cupom (opcional)",
          "info": "Exibe o código; não cria descontos. Configure a regra correspondente no admin."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link personalizado"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do botão",
          "default": "Conhecer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cartões de ofertas",
      "settings": {
        "heading": "Uma seleção para você."
      },
      "blocks": [
        {
          "type": "offer",
          "settings": {
            "heading": "Escolhas da temporada",
            "text": "Encontre os detalhes que combinam com você."
          }
        },
        {
          "type": "offer",
          "settings": {
            "heading": "Essenciais do dia",
            "text": "Descubra a seleção da nossa loja."
          }
        },
        {
          "type": "offer",
          "settings": {
            "heading": "Novas ideias",
            "text": "Explore outras possibilidades."
          }
        }
      ]
    }
  ]
}
{% endschema %}
