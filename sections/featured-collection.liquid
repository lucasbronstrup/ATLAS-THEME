{% assign featured_collection = section.settings.collection | default: collections.all %}
<section class="section" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="container"><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div><div class="product-grid" style="--columns:{{ section.settings.columns }};--mobile-columns:{{ section.settings.mobile_columns }}">{% for product in featured_collection.products limit: section.settings.limit %}{% render 'product-card', product: product, section_id: section.id %}{% else %}{% if request.design_mode %}{% for i in (1..4) %}<div class="placeholder-card">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}<h3>{{ 'general.product_placeholder' | t }}</h3><p class="muted">{{ 'general.select_collection' | t }}</p></div>{% endfor %}{% else %}<p class="muted">{{ 'general.empty_collection' | t }}</p>{% endif %}{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Coleção em destaque",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Uma seleção para você"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver tudo"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Quantidade de produtos",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 8,
      "unit": ""
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colunas no desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "unit": ""
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Colunas no celular",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Coleção em destaque"
    }
  ]
}
{% endschema %}
