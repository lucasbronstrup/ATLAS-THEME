{{ 'product-carousel.css' | asset_url | stylesheet_tag }}
{% if section.settings.layout == 'carousel' %}<script src="{{ 'product-carousel.js' | asset_url }}" defer></script>{% endif %}
<div class="section atlas-product-row product-recommendations" data-product-recommendations {% if section.settings.layout == 'carousel' %}data-product-carousel{% endif %} data-carousel-status-format="{{ 'products.carousel.position' | t: current: '{current}', total: '{total}' | escape }}" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit={{ section.settings.limit }}&amp;intent={{ section.settings.intent }}" style="--carousel-columns:{{ section.settings.columns }};--carousel-mobile-columns:{{ section.settings.mobile_columns }};{% if section.settings.spacing > 0 %}--row-space:{{ section.settings.spacing }}px;{% endif %}{% if section.settings.mobile_spacing > 0 %}--row-space-mobile:{{ section.settings.mobile_spacing }}px;{% endif %}{% if section.settings.background != blank %}--section-bg:{{ section.settings.background }};--background:{{ section.settings.background }};{% endif %}{% if section.settings.text_color != blank %}--section-ink:{{ section.settings.text_color }};--ink:{{ section.settings.text_color }};{% endif %}" {% unless recommendations.performed and recommendations.products_count > 0 or request.design_mode %}hidden{% endunless %}>
  {% if recommendations.performed and recommendations.products_count > 0 or request.design_mode %}
    <div class="container">
      <div class="section-heading">
        <div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="RecommendationsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
        {% if section.settings.layout == 'carousel' %}
          <div class="atlas-carousel-controls" data-carousel-controls hidden>
            <button class="icon-button" type="button" data-carousel-prev aria-label="{{ 'products.carousel.previous' | t }}" aria-controls="RecommendationsTrack-{{ section.id }}" disabled>{% render 'icon', name: 'arrow' %}</button>
            <button class="icon-button" type="button" data-carousel-next aria-label="{{ 'products.carousel.next' | t }}" aria-controls="RecommendationsTrack-{{ section.id }}">{% render 'icon', name: 'arrow' %}</button>
          </div>
        {% endif %}
      </div>
      <div {% if section.settings.layout == 'carousel' %}class="atlas-carousel-track" data-carousel-track tabindex="0"{% else %}class="product-grid" style="--desktop-columns:{{ section.settings.columns }}"{% endif %} id="RecommendationsTrack-{{ section.id }}" role="region" aria-labelledby="RecommendationsHeading-{{ section.id }}">
        {% for recommendation in recommendations.products %}{% if recommendation.id != product.id %}{% if section.settings.layout == 'carousel' %}<div class="atlas-carousel-cell">{% endif %}{% render 'product-card', product: recommendation, section_id: section.id %}{% if section.settings.layout == 'carousel' %}</div>{% endif %}{% endif %}{% endfor %}
      </div>
      {% if section.settings.layout == 'carousel' %}<span class="visually-hidden" data-carousel-status aria-live="polite" aria-atomic="true"></span>{% endif %}
      {% if request.design_mode %}{% unless recommendations.products_count > 0 %}<p class="atlas-product-row__empty">{{ 'products.carousel.recommendations_empty' | t }}</p>{% endunless %}{% endif %}
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "Talvez você goste",
  "tag": "section",
  "enabled_on":{"templates":["product"]},
  "settings": [
    {"type":"text","id":"eyebrow","label":"Texto de apoio","default":"SELEÇÃO PARA VOCÊ"},
    {"type":"text","id":"heading","label":"Título","default":"Talvez você goste"},
    {"type":"select","id":"intent","label":"Tipo de recomendação","options":[{"value":"related","label":"Produtos relacionados"},{"value":"complementary","label":"Produtos complementares"}],"default":"related","info":"Personalize pelo app Shopify Search & Discovery."},
    {"type":"select","id":"layout","label":"Layout","options":[{"value":"carousel","label":"Carrossel"},{"value":"grid","label":"Grade"}],"default":"carousel"},
    {"type":"range","id":"limit","label":"Quantidade de produtos","min":2,"max":10,"step":1,"default":8},
    {"type":"range","id":"columns","label":"Colunas no computador","min":2,"max":5,"step":1,"default":4},
    {"type":"select","id":"mobile_columns","label":"Produtos visíveis no celular","options":[{"value":"1","label":"1"},{"value":"1.5","label":"1,5"},{"value":"2","label":"2"}],"default":"1.5"},
    {"type":"range","id":"spacing","label":"Espaçamento no computador (0 usa o tema)","min":0,"max":120,"step":4,"default":0},
    {"type":"range","id":"mobile_spacing","label":"Espaçamento no celular (0 usa o tema)","min":0,"max":80,"step":4,"default":0},
    {"type":"color","id":"background","label":"Fundo (vazio usa o tema)"},
    {"type":"color","id":"text_color","label":"Texto (vazio usa o tema)"}
  ],
  "presets":[{"name":"Talvez você goste"}]
}
{% endschema %}
