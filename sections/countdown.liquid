{%- liquid
  assign show_countdown = false
  if section.settings.deadline != blank or request.design_mode
    assign show_countdown = true
  endif
-%}
{% if show_countdown %}<section class="section" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="container countdown-layout"><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>{% if section.settings.deadline != blank %}<div class="countdown" data-countdown="{{ section.settings.deadline | escape }}" data-expired="{{ section.settings.expired_text | escape }}" role="timer"><span data-countdown-value></span></div>{% else %}<p class="muted countdown-empty">{{ 'general.countdown_empty' | t }}</p>{% endif %}</div></section>{% endif %}
{% schema %}
{
  "name": "Campanha com prazo",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Oferta por tempo limitado"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver tudo"
    },
    {
      "type": "text",
      "id": "deadline",
      "label": "Prazo ISO com fuso (ex.: 2026-12-01T23:59:00-03:00)"
    },
    {
      "type": "text",
      "id": "expired_text",
      "label": "Mensagem após encerramento",
      "default": "Campanha encerrada"
    },
    {
      "type": "paragraph",
      "content": "Use um prazo real. O contador encerra definitivamente na data informada."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    }
  ],
  "presets": [
    {
      "name": "Campanha com prazo"
    }
  ]
}
{% endschema %}
