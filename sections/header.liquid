<header class="site-header {% if section.settings.sticky %}is-sticky{% endif %}" data-header>
<div class="header-main container"><button class="icon-button mobile-menu-button" data-mobile-menu aria-label="{{ 'general.menu' | t }}" aria-controls="MobileMenu" aria-expanded="false">{% render 'icon', name: 'menu' %}</button><a class="brand" href="{{ routes.root_url }}" style="--logo-width:{{ settings.logo_width }}px">{% if settings.logo %}{{ settings.logo | image_url: width: 520 | image_tag: widths: '160,280,400,520', loading: 'eager', alt: shop.name }}{% else %}{{ settings.brand_name | default: shop.name | escape }}{% endif %}</a>
<div class="header-search header-search--{{ section.settings.search_style | default: 'classic' }}"><form action="{{ routes.search_url }}" method="get" role="search" data-search-form><label class="visually-hidden" for="Search-{{ section.id }}">{{ 'general.search' | t }}</label>{% if section.settings.search_style == 'commerce' %}<label class="visually-hidden" for="SearchType-{{ section.id }}">{{ 'general.search_type' | t }}</label><select id="SearchType-{{ section.id }}" name="type" data-search-type><option value="product,article,page">{{ 'general.search_all' | t }}</option><option value="product">{{ 'general.product' | t }}</option><option value="article">{{ 'general.search_articles' | t }}</option><option value="page">{{ 'general.search_pages' | t }}</option></select>{% elsif section.settings.search_style == 'pill' %}<span class="search-prefix">{% render 'icon', name: 'search' %}</span>{% endif %}<input id="Search-{{ section.id }}" type="search" name="q" placeholder="{{ 'general.search_placeholder' | t }}" autocomplete="off" data-predictive-input aria-controls="Predictive-{{ section.id }}" aria-expanded="false"><input type="hidden" name="options[prefix]" value="last"><button class="{% if section.settings.search_style == 'classic' or section.settings.search_style == blank %}icon-button{% else %}header-search-submit{% endif %}" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}{% unless section.settings.search_style == 'classic' or section.settings.search_style == blank %}<span>{{ 'general.search' | t }}</span>{% endunless %}</button><div id="Predictive-{{ section.id }}" class="predictive-panel" data-predictive-container hidden></div></form></div>
<div class="header-actions">{% if shop.customer_accounts_enabled %}<shopify-account class="header-account-native" menu="{{ section.settings.customer_account_menu.handle | default: 'customer-account-main-menu' }}"><div slot="signed-out-avatar" class="header-account">{% render 'icon', name: 'user' %}<span>{{ 'general.account' | t }}</span></div></shopify-account><a class="header-account account-fallback" href="{{ routes.account_url }}">{% render 'icon', name: 'user' %}<span>{{ 'general.account' | t }}</span></a>{% endif %}<a class="header-cart" href="{{ routes.cart_url }}" data-cart-open aria-controls="CartDrawer">{% render 'cart-icon' %}<span>{{ 'general.cart' | t }}</span><b data-cart-count>{{ cart.item_count }}</b></a></div></div>
<nav class="desktop-nav container" aria-label="{{ 'general.navigation' | t }}">{% for link in section.settings.menu.links %}{% if link.links.size > 0 %}<details class="mega-nav"><summary>{{ link.title | escape }} {% render 'icon', name: 'chevron' %}</summary><div class="mega-panel"><div class="mega-grid">{% for child in link.links %}<div><a class="mega-heading" href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}</div>{% endfor %}{% assign link_key = link.title | strip | downcase %}{% for block in section.blocks %}{% assign promo_key = block.settings.menu_title | strip | downcase %}{% if promo_key != blank and promo_key == link_key %}<a class="menu-promo" href="{{ block.settings.link | default: link.url }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}{% endif %}<strong>{{ block.settings.heading | escape }}</strong><span>{{ block.settings.text | escape }}</span></a>{% endif %}{% endfor %}</div><a class="text-link" href="{{ link.url }}">{{ 'general.view_all' | t }} {% render 'icon', name: 'arrow' %}</a></div></details>{% else %}<a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}{% endfor %}{% if section.settings.utility_link != blank %}<a class="nav-utility" href="{{ section.settings.utility_link }}">{{ section.settings.utility_label | escape }}</a>{% endif %}</nav>
<dialog id="MobileMenu" class="mobile-menu-dialog" aria-labelledby="MobileMenuTitle"><div class="mobile-menu-top"><a class="brand" href="{{ routes.root_url }}">{{ settings.brand_name | default: shop.name | escape }}</a><button type="button" class="icon-button" data-mobile-menu-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div><h2 id="MobileMenuTitle" class="visually-hidden">{{ 'general.navigation' | t }}</h2><p class="mobile-menu-label">{{ 'general.explore' | t }}</p><nav class="container" aria-label="{{ 'general.navigation' | t }}">{% for link in section.settings.menu.links %}{% if link.links.size > 0 %}<details><summary>{{ link.title | escape }} {% render 'icon', name: 'chevron' %}</summary><a href="{{ link.url }}">{{ 'general.view_all' | t }}</a>{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<a class="mobile-grandchild" href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>{% endfor %}{% endfor %}</details>{% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}{% endfor %}</nav>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" class="mobile-menu-account">{% render 'icon', name: 'user' %} {{ 'general.account' | t }}</a>{% endif %}</dialog></header>
{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu principal",
      "default": "main-menu"
    },
    {
      "type": "select",
      "id": "search_style",
      "label": "Estilo da barra de pesquisa",
      "options": [
        {
          "value": "classic",
          "label": "Clássica"
        },
        {
          "value": "pill",
          "label": "Arredondada com botão"
        },
        {
          "value": "commerce",
          "label": "E-commerce com seletor"
        }
      ],
      "default": "classic"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Cabeçalho fixo",
      "default": true
    },
    {
      "type": "text",
      "id": "utility_label",
      "label": "Texto do link auxiliar",
      "default": "Precisa de ajuda?"
    },
    {
      "type": "url",
      "id": "utility_link",
      "label": "Link auxiliar"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Menu da conta do cliente",
      "default": "customer-account-main-menu"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Promoção no megamenu",
      "settings": [
        {
          "type": "text",
          "id": "menu_title",
          "label": "Título exato do item do menu",
          "info": "Use o nome de um item do menu principal que tenha submenu. A promoção aparece dentro desse submenu."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
