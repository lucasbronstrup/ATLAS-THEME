{% assign faq_count = 0 %}{% for block in section.blocks %}{% if block.settings.question != blank and block.settings.answer != blank %}{% assign faq_count = faq_count | plus: 1 %}{% endif %}{% endfor %}
<section class="section" data-product-faq style="--section-bg:{{ section.settings.background }};--section-ink:{{ section.settings.text_color }};--pad-top:{{ section.settings.padding_top }}px;--pad-bottom:{{ section.settings.padding_bottom }}px" {% if faq_count == 0 and request.design_mode == false %}hidden{% endif %}><div class="container faq-layout"><div><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></div><div class="faq-list">{% for block in section.blocks %}{% if block.settings.question != blank and block.settings.answer != blank %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}{% render 'icon', name: 'chevron' %}</summary><div class="rte">{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}{% if faq_count == 0 and request.design_mode %}<p class="faq-empty">{{ 'general.faq_empty' | t }}</p>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Perguntas frequentes",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Uma seleção para você"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver tudo"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pergunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pergunta",
          "default": "Como posso entrar em contato?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Resposta",
          "default": "<p>Use os canais de atendimento disponíveis na nossa página de contato.</p>"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Perguntas frequentes",
      "blocks": [
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
