{{ 'visual-sections.css' | asset_url | stylesheet_tag }}
<div class="section atlas-visual-section" style="{% if section.settings.spacing > 0 %}--visual-space:{{ section.settings.spacing }}px;{% endif %}{% if section.settings.mobile_spacing > 0 %}--visual-space-mobile:{{ section.settings.mobile_spacing }}px;{% endif %}{% if section.settings.background != blank %}--section-bg:{{ section.settings.background }};--background:{{ section.settings.background }};{% endif %}{% if section.settings.text_color != blank %}--section-ink:{{ section.settings.text_color }};--ink:{{ section.settings.text_color }};{% endif %}"><div class="container">{% if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.text != blank %}<div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div></div>{% endif %}<div class="atlas-service-grid" style="--service-columns:{{ section.settings.columns }}">
{% for block in section.blocks %}{% assign destination = block.settings.link %}{% if destination == blank and block.settings.use_account and shop.customer_accounts_enabled %}{% assign destination = routes.account_url %}{% endif %}<article class="atlas-service-card atlas-visual-card" {{ block.shopify_attributes }}><div class="atlas-service-card__icon">{% render 'icon', name: block.settings.icon %}</div><h3>{{ block.settings.heading | escape }}</h3>{% if block.settings.text != blank %}<p class="muted">{{ block.settings.text | escape }}</p>{% endif %}{% if destination != blank and block.settings.button_label != blank %}<a class="text-link" href="{{ destination }}">{{ block.settings.button_label | escape }}{% render 'icon', name: 'arrow' %}</a>{% endif %}</article>{% endfor %}
</div></div></div>
{% schema %}
{
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "name": "Atendimento e informações",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Espaço no computador (0 usa o tema)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "label": "Espaço no celular (0 usa o tema)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0,
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo (vazio usa o tema)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto (vazio usa o tema)"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colunas no computador",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Informação",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            {
              "value": "chat",
              "label": "Atendimento"
            },
            {
              "value": "truck",
              "label": "Entrega"
            },
            {
              "value": "return",
              "label": "Trocas"
            },
            {
              "value": "shield",
              "label": "Políticas"
            },
            {
              "value": "user",
              "label": "Conta"
            }
          ],
          "default": "chat"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Descrição"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto do link",
          "default": "Saiba mais"
        },
        {
          "type": "checkbox",
          "id": "use_account",
          "label": "Usar conta do cliente se o link estiver vazio",
          "default": false,
          "info": "Só exibe o link quando as contas de cliente estão habilitadas."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atendimento e informações",
      "settings": {
        "heading": "Como podemos ajudar?"
      },
      "blocks": [
        {
          "type": "service",
          "settings": {
            "icon": "chat",
            "heading": "Atendimento",
            "text": "Conheça os nossos canais de contato."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "truck",
            "heading": "Seu pedido",
            "text": "Veja os detalhes dos seus pedidos na sua conta.",
            "use_account": true,
            "button_label": "Acessar conta"
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "return",
            "heading": "Trocas e devoluções",
            "text": "Consulte as condições da loja."
          }
        },
        {
          "type": "service",
          "settings": {
            "icon": "shield",
            "heading": "Informações de compra",
            "text": "Encontre as nossas políticas e condições."
          }
        }
      ]
    }
  ]
}
{% endschema %}
