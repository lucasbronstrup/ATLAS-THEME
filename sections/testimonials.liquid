<section class="section" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="container"><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div><div class="testimonial-grid">{% for block in section.blocks %}<figure class="testimonial" {{ block.shopify_attributes }}>{% if block.settings.rating > 0 %}<div class="stars" aria-label="{{ 'general.rating' | t: rating: block.settings.rating }}">{% for i in (1..block.settings.rating) %}{% render 'icon', name: 'star' %}{% endfor %}</div>{% endif %}<blockquote>{{ block.settings.quote | escape }}</blockquote><figcaption>{{ block.settings.author | escape }}{% if block.settings.source != blank %}<a href="{{ block.settings.source }}">{{ 'general.source' | t }}</a>{% endif %}</figcaption></figure>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Depoimentos reais",
  "settings": [
    {
      "type": "paragraph",
      "content": "Inclua apenas depoimentos reais, com autorização. Não gera avaliações de produto no SEO."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Uma seleção para você"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver tudo"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Depoimento",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Depoimento"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Autor"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Nota (0 oculta)",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 0,
          "unit": ""
        },
        {
          "type": "url",
          "id": "source",
          "label": "Fonte"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Depoimentos reais"
    }
  ]
}
{% endschema %}
