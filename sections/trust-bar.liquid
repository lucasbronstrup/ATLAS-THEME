<section class="section trust-section" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="container trust-grid">{% for block in section.blocks %}<div class="trust-item" {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}<div>{% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}</div></div>{% endfor %}</div></section>
{% schema %}
{
  "name": "Benefícios e confiança",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            {
              "value": "truck",
              "label": "Entrega"
            },
            {
              "value": "shield",
              "label": "Segurança"
            },
            {
              "value": "return",
              "label": "Troca"
            },
            {
              "value": "chat",
              "label": "Atendimento"
            },
            {
              "value": "check",
              "label": "Check"
            }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Compra segura"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Descrição",
          "default": "Checkout protegido pela Shopify"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Benefícios e confiança",
      "blocks": [
        {
          "type": "benefit"
        }
      ]
    }
  ]
}
{% endschema %}
