<section class="section" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="container"><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div><div class="promo-grid" style="--columns:{{ section.settings.columns }}">{% for block in section.blocks %}<article class="promo-card" style="background:{{ block.settings.background }};color:{{ block.settings.text_color }}" {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'promo-image', widths: '400,700,1000' }}{% endif %}<div class="promo-copy"><p class="eyebrow">{{ block.settings.eyebrow | escape }}</p><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.text | escape }}</p>{% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></article>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Mosaico de promoções",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Uma seleção para você"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver tudo"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colunas",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "unit": ""
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Banner",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Texto superior",
          "default": "SELEÇÃO ESPECIAL"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Feito para o seu dia."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Descrição"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botão",
          "default": "Descubra"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "color",
          "id": "background",
          "label": "Fundo",
          "default": "#ecefe9"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Texto",
          "default": "#172229"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Mosaico de promoções",
      "blocks": [
        {
          "type": "promo"
        },
        {
          "type": "promo"
        }
      ]
    }
  ]
}
{% endschema %}
