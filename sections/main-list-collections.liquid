<section class="section collection-list-page"><div class="container"><h1 class="section-heading">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'secondary.collections.title' | t }}{% endif %}</h1>
  {% if section.settings.collection_list != blank %}{% assign displayed_collections = section.settings.collection_list %}{% else %}{% assign displayed_collections = collections %}{% endif %}
  {% paginate displayed_collections by section.settings.collections_per_page %}
    <div class="collection-list-grid" style="--collection-columns: {{ section.settings.columns }}">{% for collection in displayed_collections %}<a href="{{ collection.url }}" class="collection-list-card"><div class="collection-list-card__image">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 900px) 33vw, 50vw', loading: 'lazy' }}{% else %}{{ 'collection-1' | placeholder_svg_tag }}{% endif %}</div><div class="collection-list-card__heading"><div><h2>{{ collection.title | escape }}</h2>{% if section.settings.show_count %}<p class="muted">{{ 'catalog.products_count' | t: count: collection.all_products_count }}</p>{% endif %}</div><span aria-hidden="true">↗</span></div></a>{% else %}<p class="muted">{{ 'secondary.collections.empty' | t }}</p>{% endfor %}</div>
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
</div></section>
{% schema %}
{
  "name": "Página de coleções",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título personalizado"
    },
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Coleções selecionadas",
      "info": "Deixe vazio para mostrar todas as coleções."
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "label": "Coleções por página",
      "min": 6,
      "max": 30,
      "step": 6,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colunas no computador",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Mostrar quantidade de produtos",
      "default": true
    }
  ]
}
{% endschema %}
