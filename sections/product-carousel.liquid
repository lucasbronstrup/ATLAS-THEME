{{ 'product-carousel.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-carousel.js' | asset_url }}" defer></script>
{%- liquid
  assign source_collection = section.settings.collection
  if source_collection == blank
    assign source_collection = product.collections.first | default: collections.all
  endif
  assign carousel_products = section.settings.products
  if carousel_products == blank
    assign carousel_products = source_collection.products
  endif
  assign rendered_count = 0
-%}
{%- capture product_cards -%}
  {%- for carousel_product in carousel_products limit: 24 -%}
    {%- if section.settings.exclude_current and carousel_product.id == product.id -%}{% continue %}{%- endif -%}
    <div class="atlas-carousel-cell">{% render 'product-card', product: carousel_product, section_id: section.id %}</div>
    {%- assign rendered_count = rendered_count | plus: 1 -%}
    {%- if rendered_count >= section.settings.limit -%}{% break %}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
<div class="section atlas-product-row" data-product-carousel data-carousel-status-format="{{ 'products.carousel.position' | t: current: '__current__', total: '__total__' }}" style="--carousel-columns:{{ section.settings.columns }};--carousel-mobile-columns:{{ section.settings.mobile_columns }};{% if section.settings.spacing > 0 %}--row-space:{{ section.settings.spacing }}px;{% endif %}{% if section.settings.mobile_spacing > 0 %}--row-space-mobile:{{ section.settings.mobile_spacing }}px;{% endif %}{% if section.settings.background != blank %}--section-bg:{{ section.settings.background }};--background:{{ section.settings.background }};{% endif %}{% if section.settings.text_color != blank %}--section-ink:{{ section.settings.text_color }};--ink:{{ section.settings.text_color }};{% endif %}" {% if rendered_count == 0 and request.design_mode == false %}hidden{% endif %}>
  <div class="container">
    <div class="section-heading">
      <div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2 id="CarouselHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
      <div class="atlas-product-row__actions">
        {% if section.settings.show_view_all and source_collection != blank %}<a class="text-link" href="{{ source_collection.url }}">{{ 'products.carousel.view_all' | t }} <span aria-hidden="true">↗</span></a>{% endif %}
        <div class="atlas-carousel-controls" data-carousel-controls hidden>
          <button class="icon-button" type="button" data-carousel-prev aria-label="{{ 'products.carousel.previous' | t }}" aria-controls="CarouselTrack-{{ section.id }}" disabled>{% render 'icon', name: 'arrow' %}</button>
          <button class="icon-button" type="button" data-carousel-next aria-label="{{ 'products.carousel.next' | t }}" aria-controls="CarouselTrack-{{ section.id }}">{% render 'icon', name: 'arrow' %}</button>
        </div>
      </div>
    </div>
    <div class="atlas-carousel-track" id="CarouselTrack-{{ section.id }}" data-carousel-track tabindex="0" role="region" aria-labelledby="CarouselHeading-{{ section.id }}">{{ product_cards }}</div>
    <span class="visually-hidden" data-carousel-status aria-live="polite" aria-atomic="true"></span>
    {% if rendered_count == 0 and request.design_mode %}<p class="atlas-product-row__empty">{{ 'products.carousel.editor_empty' | t }}</p>{% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Carrossel de produtos",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Explore mais"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Produtos selecionados",
      "limit": 24,
      "info": "Se vazio, usa a coleção escolhida. Sem coleção, usa a coleção do produto ou o catálogo."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "checkbox",
      "id": "exclude_current",
      "label": "Ocultar o produto da página atual",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar link para a coleção",
      "default": true
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Quantidade de produtos",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Produtos visíveis no computador",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Produtos visíveis no celular",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "1.5",
          "label": "1,5"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Espaçamento no computador (0 usa o tema)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "label": "Espaçamento no celular (0 usa o tema)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0,
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo (vazio usa o tema)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto (vazio usa o tema)"
    }
  ],
  "presets": [
    {
      "name": "Carrossel de produtos"
    }
  ]
}
{% endschema %}
