<section class="section newsletter-section" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="container newsletter-layout"><div><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></div><div>{% assign form_id = 'Newsletter-' | append: section.id %}{% form 'customer', id: form_id %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="Email-{{ section.id }}">{{ 'general.email' | t }}</label><div class="newsletter-fields"><input id="Email-{{ section.id }}" type="email" name="contact[email]" placeholder="{{ 'general.email_placeholder' | t }}" required autocomplete="email"><button class="button">{{ 'general.subscribe' | t }} {% render 'icon', name: 'arrow' %}</button></div>{{ form.errors | default_errors }}{% if form.posted_successfully? %}<p role="status">{{ 'general.subscribed' | t }}</p>{% endif %}<div class="newsletter-fineprint rte">{{ section.settings.disclaimer }}</div>{% endform %}</div></div></section>
{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Uma seleção para você"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver tudo"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Texto de consentimento"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "heading": "Novidades que valem a pena.",
        "text": "<p>Receba lançamentos e conteúdos da nossa loja.</p>",
        "background": "#ddf38b"
      }
    }
  ]
}
{% endschema %}
