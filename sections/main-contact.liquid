<section class="section contact-page"><div class="container">
  <div class="contact-layout">
    <div class="contact-layout__intro"><h1 class="section-heading">{{ section.settings.heading | default: page.title | escape }}</h1>{% if page.content != blank %}<div class="rte">{{ page.content }}</div>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}
      {% for block in section.blocks %}<div class="contact-info" {{ block.shopify_attributes }}>{% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}<div class="rte muted">{{ block.settings.content }}</div></div>{% endfor %}
    </div>
    <div class="contact-layout__form">
      {% form 'contact', id: 'ContactForm', class: 'contact-form' %}
        {% if form.posted_successfully? %}<p class="form-success" role="status" tabindex="-1">{{ 'secondary.contact.success' | t }}</p>{% endif %}
        {% if form.errors %}<div class="form-error" role="alert" tabindex="-1">{{ form.errors | default_errors }}</div>{% endif %}
        <div class="form-row"><div class="field"><label for="ContactName">{{ 'secondary.contact.name' | t }}</label><input id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"></div>
        <div class="field"><label for="ContactEmail">{{ 'secondary.contact.email' | t }} <span aria-hidden="true">*</span></label><input id="ContactEmail" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" required aria-required="true" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}></div></div>
        {% if section.settings.show_phone %}<div class="field"><label for="ContactPhone">{{ 'secondary.contact.phone' | t }}</label><input id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone | escape }}"></div>{% endif %}
        <div class="field"><label for="ContactMessage">{{ 'secondary.contact.message' | t }} <span aria-hidden="true">*</span></label><textarea id="ContactMessage" name="contact[body]" rows="7" required aria-required="true">{{ form.body | escape }}</textarea></div>
        <p class="muted form-required">{{ 'secondary.contact.required' | t }}</p>
        <button type="submit" class="button">{{ 'secondary.contact.send' | t }}</button>
      {% endform %}
    </div>
  </div>
</div></section>
{% schema %}
{"name":"Contato","settings":[{"type":"text","id":"heading","label":"Título personalizado"},{"type":"richtext","id":"text","label":"Texto adicional"},{"type":"checkbox","id":"show_phone","label":"Mostrar campo de telefone","default":true}],"blocks":[{"type":"info","name":"Informação de contato","settings":[{"type":"text","id":"heading","label":"Título"},{"type":"richtext","id":"content","label":"Informação"}]}],"max_blocks":4}
{% endschema %}
