<section class="hero-section" data-slideshow style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="hero-track">{% for block in section.blocks %}<article class="hero hero--{{ section.settings.layout }}" id="Slide-{{ section.id }}-{{ forloop.index }}" {{ block.shopify_attributes }}><div class="container hero-inner"><div class="hero-copy">{% if block.settings.eyebrow != blank %}<p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading_tag == 'h1' and forloop.first %}<h1>{{ block.settings.heading | escape }}</h1>{% else %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}<div class="rte">{{ block.settings.text }}</div><div class="hero-buttons">{% if block.settings.button_label != blank %}<a class="button button--accent" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}{% if block.settings.secondary_label != blank and block.settings.secondary_link != blank %}<a class="text-link" href="{{ block.settings.secondary_link }}">{{ block.settings.secondary_label | escape }}</a>{% endif %}</div></div><div class="hero-art">{% if block.settings.image %}{% if forloop.first %}{{ block.settings.image | image_url: width: 2000 | image_tag: widths: '500,750,1000,1500,2000', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high' }}{% else %}{{ block.settings.image | image_url: width: 2000 | image_tag: widths: '500,750,1000,1500,2000', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'lazy' }}{% endif %}{% else %}<img src="{{ 'atlas-editorial.svg' | asset_url }}" alt="" width="1000" height="900" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>{% endif %}</div></div></article>{% endfor %}</div>{% if section.blocks.size > 1 %}<div class="slideshow-controls container"><button class="icon-button" data-slide-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow' %}</button><span data-slide-status aria-live="polite">1 / {{ section.blocks.size }}</span><button class="icon-button" data-slide-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button></div>{% endif %}</section>
{% schema %}
{
  "name": "Banner / apresentação",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Composição",
      "options": [
        {
          "value": "split",
          "label": "Imagem ao lado"
        },
        {
          "value": "full",
          "label": "Imagem de fundo"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Título principal (use H1 só uma vez)",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Texto superior",
          "default": "NOVAS POSSIBILIDADES"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Título",
          "default": "O essencial.\nCom uma nova perspectiva."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Descrição",
          "default": "<p>Uma seleção de produtos para transformar o seu dia a dia.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Botão",
          "default": "Explore a coleção"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link do botão"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Link secundário"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Destino secundário"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Banner / apresentação",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}

