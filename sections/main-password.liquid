<section class="password-page"><div class="password-page__inner">
  {% if settings.logo %}{{ settings.logo | image_url: width: 500 | image_tag: width: settings.logo_width, class: 'password-page__logo', loading: 'eager' }}{% else %}<a href="{{ routes.root_url }}" class="password-page__brand">{{ shop.name | escape }}</a>{% endif %}
  <h1>{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'secondary.password.title' | t }}{% endif %}</h1>
  {% if shop.password_message != blank %}<div class="rte muted">{{ shop.password_message }}</div>{% endif %}
  {% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}
  {% if section.settings.show_newsletter %}
    {% form 'customer', id: 'PasswordNewsletter', class: 'password-newsletter' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}<p class="form-success" role="status">{{ 'secondary.password.subscribed' | t }}</p>{% endif %}
      {% if form.errors %}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <label for="PasswordNewsletterEmail" class="visually-hidden">{{ 'secondary.contact.email' | t }}</label><input id="PasswordNewsletterEmail" type="email" name="contact[email]" placeholder="{{ 'secondary.password.email_placeholder' | t }}" autocomplete="email" autocapitalize="off" required><button type="submit" class="button">{{ 'secondary.password.notify' | t }}</button>
    {% endform %}
  {% endif %}
  {% assign password_error = false %}{%- capture password_form -%}{% form 'storefront_password', id: 'PasswordLogin', class: 'password-login__form' %}{% if form.errors %}{% assign password_error = true %}<div class="form-error" role="alert" id="PasswordLoginError">{{ form.errors | default_errors }}</div>{% endif %}<label for="StorePassword">{{ 'secondary.password.password' | t }}</label><input id="StorePassword" type="password" name="password" autocomplete="current-password" required{% if password_error %} aria-invalid="true" aria-describedby="PasswordLoginError" autofocus{% endif %}><button type="submit" class="button">{{ 'secondary.password.submit' | t }}</button>{% endform %}{%- endcapture -%}<details class="password-login"{% if password_error %} open{% endif %}><summary>{{ 'secondary.password.enter' | t }}</summary>{{ password_form }}</details>
  <p class="password-owner muted">{{ 'secondary.password.owner' | t }} <a href="/admin">{{ 'secondary.password.admin' | t }}</a></p>
</div></section>
{% schema %}
{"name":"Página de senha","settings":[{"type":"text","id":"heading","label":"Título personalizado"},{"type":"richtext","id":"text","label":"Mensagem adicional"},{"type":"checkbox","id":"show_newsletter","label":"Mostrar cadastro de novidades","default":true}]}
{% endschema %}
