<section class="section" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="container"><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div><div class="logo-grid">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}{% if block.settings.image %}{{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name }}{% else %}<span>{{ block.settings.name | escape }}</span>{% endif %}{% if block.settings.link != blank %}</a>{% endif %}</div>{% endfor %}</div></div></section>
{% schema %}
{
  "name": "Marcas / logos",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Marcas parceiras"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver tudo"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagem"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nome",
          "default": "Nome da marca"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Marcas / logos",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
