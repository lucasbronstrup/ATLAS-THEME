{% if section.settings.text != blank %}<div class="announcement" style="background:{{ section.settings.background }};color:{{ section.settings.text_color }}">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}{{ section.settings.text | escape }}{% if section.settings.link != blank %} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>{% endif %}
{% schema %}
{
  "name": "Barra de anúncio",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Mensagem",
      "default": "Conheça nossa seleção de novidades"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ddf38b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    }
  ],
  "presets": [
    {
      "name": "Barra de anúncio"
    }
  ]
}
{% endschema %}
