<section class="section rich-text-section" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pad-top: {{ section.settings.padding_top }}px; --pad-bottom: {{ section.settings.padding_bottom }}px"><div class="container narrow" style="text-align:{{ section.settings.alignment }}"><div class="section-heading"><div>{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.text != blank %}<div class="rte muted">{{ section.settings.text }}</div>{% endif %}</div>{% if section.settings.link != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Texto editorial",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto superior"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Conte a sua história"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Descrição",
      "default": "<p>Use este espaço para apresentar a sua marca, uma campanha ou informações importantes para os seus clientes.</p>"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Texto do link",
      "default": "Ver tudo"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Alinhamento",
      "default": "center"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Fundo",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Texto",
      "default": "#172229"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaço superior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaço inferior",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px",
      "info": "Sem efeito enquanto “Usar espaçamento global nas seções” estiver ativo em Configurações do tema > Espaçamentos e botões."
    }
  ],
  "presets": [
    {
      "name": "Texto editorial"
    }
  ]
}
{% endschema %}
