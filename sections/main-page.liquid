<section class="section page-content"><div class="container page-content__inner" style="--page-width: {{ section.settings.content_width }}px">
  {% if section.settings.show_title %}<h1 class="section-heading">{{ page.title | escape }}</h1>{% endif %}
  <div class="rte">{{ page.content }}</div>
</div></section>
{% schema %}
{"name":"Página","settings":[{"type":"checkbox","id":"show_title","label":"Mostrar título","default":true},{"type":"range","id":"content_width","label":"Largura do conteúdo","min":600,"max":1400,"step":100,"unit":"px","default":900}]}
{% endschema %}
