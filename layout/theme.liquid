<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" {% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' %}dir="rtl"{% endif %}>
<head>
<meta charset="utf-8"><script>document.documentElement.classList.replace('no-js','js');</script><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="{{ settings.color_header }}">
<title>{{ page_title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} — {{ 'general.page' | t: page: current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
{% if settings.favicon %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
{% render 'meta-tags' %}
{{ content_for_header }}
{% render 'theme-styles' %}
{{ 'theme.css' | asset_url | stylesheet_tag }}{{ 'product.css' | asset_url | stylesheet_tag }}{{ 'catalog.css' | asset_url | stylesheet_tag }}{{ 'rhythm.css' | asset_url | stylesheet_tag }}{{ 'commerce.css' | asset_url | stylesheet_tag }}
<script src="{{ 'theme.js' | asset_url }}" defer></script><script src="{{ 'product.js' | asset_url }}" defer></script>
</head>
<body data-card-shadow="{{ settings.card_shadow_enable }}" data-image-shadow="{{ settings.image_shadow_enable }}" data-shadow-strength="{{ settings.shadow_strength }}" data-uniform-spacing="{{ settings.uniform_spacing }}" data-style="{{ settings.design_style }}" data-animations="{{ settings.enable_animations }}">
<a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
{% sections 'header-group' %}
<main id="MainContent" tabindex="-1">{% render 'breadcrumbs' %}{{ content_for_layout }}</main>
{% sections 'footer-group' %}
{% if settings.enable_cart_drawer %}{% section 'cart-drawer' %}{% endif %}
<div id="AtlasStatus" class="visually-hidden" role="status" aria-live="polite"></div>
{% if settings.show_back_to_top %}<a class="back-top" href="#MainContent" aria-label="{{ 'general.back_top' | t }}">{% render 'icon', name: 'up' %}</a>{% endif %}
<script id="AtlasConfig" type="application/json">{"root":{{ routes.root_url | json }},"cartAdd":{{ routes.cart_add_url | append: '.js' | json }},"cartChange":{{ routes.cart_change_url | append: '.js' | json }},"cartUpdate":{{ routes.cart_update_url | append: '.js' | json }},"cart":{{ routes.cart_url | json }},"search":{{ routes.predictive_search_url | json }},"drawer":{{ settings.enable_cart_drawer | json }},"predictive":{{ settings.enable_predictive_search | json }},"strings":{"added":{{ 'general.added' | t | json }},"updated":{{ 'general.cart_updated' | t | json }},"error":{{ 'general.error' | t | json }},"loading":{{ 'general.loading' | t | json }}}}</script>
</body></html>
