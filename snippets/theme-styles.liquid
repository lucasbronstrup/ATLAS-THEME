{% doc %}
Renders merchant-configurable fonts and global design tokens.
{% enddoc %}
{% assign selected_cart_icon = settings.cart_icon_style | default: 'bag' %}{% assign cart_icon_asset = 'cart-icon-' | append: selected_cart_icon | append: '.svg' %}
{% style %}
{{ settings.font_body | font_face: font_display: 'swap' }}
{{ settings.font_heading | font_face: font_display: 'swap' }}
{% assign body_bold = settings.font_body | font_modify: 'weight', 'bold' %}{{ body_bold | font_face: font_display: 'swap' }}
:root{--cart-icon-image:url("{{ cart_icon_asset | asset_url }}");--ink:{{ settings.color_text }};--muted:{{ settings.color_muted }};--accent:{{ settings.color_accent }};--accent-ink:{{ settings.color_accent_text }};--surface:{{ settings.color_surface }};--line:{{ settings.color_line }};--background:{{ settings.color_background }};--button:{{ settings.color_button }};--button-ink:{{ settings.color_button_text }};--header:{{ settings.color_header }};--header-ink:{{ settings.color_header_text }};--radius:{{ settings.corner_radius }}px;--container:{{ settings.page_width }}px;--font-body:{{ settings.font_body.family }},{{ settings.font_body.fallback_families }};--font-heading:{{ settings.font_heading.family }},{{ settings.font_heading.fallback_families }};--font-heading-weight:{{ settings.font_heading.weight }};--font-heading-style:{{ settings.font_heading.style }};--font-size:{{ settings.font_size }}px;--spacing-section:{{ settings.section_spacing | default: 48 }}px;--spacing-section-mobile:{{ settings.section_spacing_mobile | default: 32 }}px;--content-gap:{{ settings.content_gap | default: 24 }}px;--content-gap-mobile:{{ settings.content_gap_mobile | default: 16 }}px;--control-gap:12px;--button-height:{{ settings.button_height | default: 52 }}px;--heading-scale:{{ settings.heading_scale | divided_by: 100.0 }}}
{% endstyle %}
