{% doc %}
Renders context-aware breadcrumbs.
{% enddoc %}
{% if request.page_type != 'index' %}<nav class="breadcrumbs container" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>{% if request.page_type == 'product' %}{% if collection %}<a href="{{ collection.url }}">{{ collection.title | escape }}</a><span aria-hidden="true">/</span>{% endif %}<span aria-current="page">{{ product.title | escape }}</span>{% elsif request.page_type == 'collection' %}<span aria-current="page">{{ collection.title | escape }}</span>{% elsif request.page_type == 'article' %}<a href="{{ blog.url }}">{{ blog.title | escape }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ article.title | escape }}</span>{% else %}<span aria-current="page">{{ page_title | escape }}</span>{% endif %}</nav>{% endif %}
{% if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'page' or request.page_type == 'blog' or request.page_type == 'article' %}<script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":{{ 'general.home' | t | json }},"item":{{ request.origin | append: routes.root_url | json }}},{"@type":"ListItem","position":2,"name":{{ page_title | json }},"item":{{ canonical_url | json }}}]}</script>{% endif %}
