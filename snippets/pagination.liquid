{% doc %}
  Renders accessible page links for a paginated object.
  @param {paginate} paginate - The current pagination object
  @example
  {% render 'pagination', paginate: paginate %}
{% enddoc %}
{% if paginate.pages > 1 %}
  <nav class="pagination" aria-label="{{ 'catalog.pagination.label' | t }}">
    {% if paginate.previous %}<a href="{{ paginate.previous.url }}" class="pagination__arrow" aria-label="{{ 'catalog.pagination.previous' | t }}">←</a>{% endif %}
    {% for part in paginate.parts %}
      {% if part.is_link %}
        <a href="{{ part.url }}" aria-label="{{ 'catalog.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
      {% elsif part.title == paginate.current_page %}
        <span aria-current="page" aria-label="{{ 'catalog.pagination.page' | t: number: part.title }}">{{ part.title }}</span>
      {% else %}<span class="pagination__ellipsis">{{ part.title }}</span>{% endif %}
    {% endfor %}
    {% if paginate.next %}<a href="{{ paginate.next.url }}" class="pagination__arrow" aria-label="{{ 'catalog.pagination.next' | t }}">→</a>{% endif %}
  </nav>
{% endif %}
