        "pickup": {"type":"pickup"},
        "description": {"type":"description","settings":{"collapsible":true,"heading":"Detalhes do produto","open":true}},
        "secure": {"type":"secure_payment","settings":{"heading":"Pagamento seguro","text":"<p>Finalize sua compra no checkout da Shopify.</p>","show_payment_icons":true,"show_payment_terms":true}}
      },
      "block_order": ["title","price","inventory","variants","purchase","guarantee","pickup","description","secure"],
      "settings": {"media_width":"large","image_fit":"contain","sticky_information":true,"sticky_add_to_cart":true,"spacing":40}
    },
    "recommendations": {
      "type":"product-recommendations",
      "settings":{"eyebrow":"SELEÇÃO PARA VOCÊ","heading":"Talvez você goste","intent":"related","layout":"carousel","limit":8,"columns":4,"mobile_columns":"1.5","spacing":0,"mobile_spacing":0}
    },
    "recent": {
      "type":"recently-viewed",
      "settings":{"heading":"Visto recentemente","show_clear":true,"limit":8,"columns":4,"mobile_columns":"1.5","spacing":0,"mobile_spacing":0}
    },
