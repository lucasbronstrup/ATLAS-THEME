{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {"type":"title","settings":{"show_vendor":true}},
        "price": {"type":"price","settings":{"show_tax":true}},
        "inventory": {"type":"inventory","settings":{"show_count":false}},
        "variants": {"type":"variant_picker","settings":{"picker_type":"images","show_swatches":true}},
        "purchase": {"type":"buy_buttons","settings":{"show_dynamic_checkout":true,"button_style":"accent","show_payment_icons":true}},
