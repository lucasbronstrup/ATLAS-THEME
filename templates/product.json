      "settings":{"heading":"Nossa marca e outras marcas","feature_heading":"Características","features":"Qualidade\nEspecificações\nAtendimento","padding_top":48,"padding_bottom":48}
    },
    "faq": {
      "type":"faq",
      "blocks":{"contact":{"type":"question","settings":{"question":"Como posso tirar dúvidas antes de comprar?","answer":"<p>Use os canais de atendimento informados na loja. Você também pode consultar os detalhes do produto e as políticas de compra.</p>"}}},
      "block_order":["contact"],
      "settings":{"heading":"Perguntas frequentes","padding_top":48,"padding_bottom":48}
    }
