      "type":"comparison-table",
      "blocks":{"ours":{"type":"brand","settings":{"heading":"Nossa marca","highlight":true,"values":"—\n—\n—"}},"others":{"type":"brand","settings":{"heading":"Outras marcas","values":"—\n—\n—"}}},
